# Przypięte wersje — odtwarzalność środowiska (K.1).
# Zmieniaj świadomie: po zmianie przetestuj `make up && make test` i odnotuj to w README.
# Plik jest czytany przez bash na hoście i na węzłach, więc tylko proste przypisania.

K3S_VERSION="v1.37.2+k3s1"
FALCO_CHART_VERSION="9.2.2"      # Falco 0.45.2
TETRAGON_CHART_VERSION="1.8.0"   # na razie nieużywane (K.8)

# Obraz bazowy VM na Linuksie (TRANSPORT=libvirt). "current" śledzi najnowsze noble;
# dla pełnej odtwarzalności podmień na konkretny release, np. .../noble/releases/<data>/...
UBUNTU_IMAGE_URL="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
